# Copie este arquivo para `.env` e preencha. O `.env` está no .gitignore —
# NUNCA comite certificado ou senha.

# homologacao = produção restrita (para testar). producao = nota fiscal real.
# Comece SEMPRE em homologacao.
NFSE_AMBIENTE=homologacao

# Certificado A1 (e-CNPJ, ICP-Brasil) em base64. Para gerar a partir do .pfx:
#   Windows PowerShell:
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\caminho\cert.pfx")) > cert.b64.txt
#   Linux/macOS:
#     base64 -w0 cert.pfx > cert.b64.txt
NFSE_CERT_PFX_BASE64=
NFSE_CERT_SENHA=

# ── Prestador (quem emite) ───────────────────────────────────────────────────
NFSE_PRESTADOR_CNPJ=
# Inscrição Municipal — obrigatória na maioria dos municípios (erro E0099 sem ela)
NFSE_PRESTADOR_IM=
# Código IBGE do município, 7 dígitos. Consulte em
# https://www.ibge.gov.br/explica/codigos-dos-municipios.php
NFSE_MUNICIPIO_IBGE=

# Regime tributário: 1=não optante | 2=optante MEI | 3=optante ME/EPP
NFSE_OP_SIMP_NAC=3

# ── Numeração da nota ────────────────────────────────────────────────────────
# A série é sua (comece em 1). O número precisa ser SEQUENCIAL e único dentro
# da série — reenviar um número já usado é rejeitado pela SEFIN.
# No seu sistema isso vem de um contador no banco, não de uma variável.
NFSE_SERIE=1
NFSE_NUMERO=1

# ── Tomador (quem recebe o serviço) — só para o exemplo rodar ────────────────
NFSE_TOMADOR_DOC=
NFSE_TOMADOR_NOME=
NFSE_TOMADOR_EMAIL=

# ── Serviço ──────────────────────────────────────────────────────────────────
# Código de tributação nacional (item da LC 116 + desdobro). 080101 = ensino
# regular. A lista completa está no ANEXO do leiaute nacional.
NFSE_COD_TRIBUTACAO=080101
NFSE_DESCRICAO_SERVICO=Prestacao de servico
NFSE_VALOR=100.00
