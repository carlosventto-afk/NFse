# Usado por --env-file .env.prod (ver docker-compose.prod.yml e
# docs/deploy.md) — as chaves abaixo alimentam tanto o container do
# Postgres quanto DATABASE_URL via substituicao do proprio docker compose,
# entao so precisam ser preenchidas uma vez aqui.
POSTGRES_PASSWORD=
FERNET_KEY=
JWT_SECRET=
JWT_TTL_HORAS=8
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
APP_BASE_URL=https://nfse.gestaotecnologia.com
